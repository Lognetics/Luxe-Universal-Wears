# Luxe Universal Wears — environment variables
# Copy to .env.local and fill in. .env.local is gitignored.
# The public site runs WITHOUT these (catalog falls back to local JSON).

# Public — needed by the site + admin panel (also add these two to Vercel):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Only needed locally for one-time DB setup (scripts/db-setup.mjs):
SUPABASE_DB_URL=postgresql://postgres:<password>@<host>:5432/postgres
ADMIN_EMAILS=admin@example.com

# NETICS AI storefront concierge (public identifiers; also add to Vercel).
# Leave NEXT_PUBLIC_NETICS_AGENT_ID empty until the Luxe agent has been
# published and both production origins have been allow-listed in NETICS.
NEXT_PUBLIC_NETICS_AGENT_ID=
NEXT_PUBLIC_NETICS_API_BASE=https://business.neticsai.com
# Canonical site origin, used for product page and image links sent to NETICS.
NEXT_PUBLIC_SITE_URL=https://luxeuniversalwears.com

# Server only (Vercel: Production, never NEXT_PUBLIC_). Minted in the NETICS
# console under API & Webhooks with the write:products scope. With it, every
# product save, delete and publish in /admin updates the concierge's
# catalogue immediately. Without it, pushes are skipped and the nightly feed
# at /api/netics/products keeps NETICS in step instead.
NETICS_API_KEY=
